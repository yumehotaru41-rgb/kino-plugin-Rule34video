{
  "id": "rule34video",
  "name": "Rule34Video",
  "version": "1.3.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Videos de rule34video.com: busca por título, tags o artistas. Favoritos (con sesión), 3D y calidad configurable.",
  "author": "community",
  "homepage": "https://rule34video.com",
  "hosts": [
    "rule34video.com",
    "*.rule34video.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "resolve"
  ],
  "categories": [
    "adult"
  ],
  "color": "#E85A4F",
  "icon": "icon.png",
  "settings": [
    {
      "key": "quality",
      "label": "Calidad de video",
      "type": "select",
      "default": "best",
      "options": [
        {
          "value": "best",
          "label": "La mejor disponible"
        },
        {
          "value": "1080",
          "label": "1080p"
        },
        {
          "value": "720",
          "label": "720p"
        },
        {
          "value": "480",
          "label": "480p"
        },
        {
          "value": "360",
          "label": "360p"
        }
      ]
    },
    {
      "key": "loginSection",
      "label": "Cuenta (opcional)",
      "type": "section",
      "hint": "Si tienes cuenta en rule34video.com puedes iniciar sesión. No es obligatorio para buscar y reproducir."
    },
    {
      "key": "user",
      "label": "Usuario",
      "type": "text"
    },
    {
      "key": "password",
      "label": "Contraseña",
      "type": "password"
    }
  ]
}